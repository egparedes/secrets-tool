#!/bin/sh
# secrets -- command-line front end for secrets-lib.sh
#
# Locates the library, sources it, and hands off to the secrets()
# dispatcher. Holds no secret-store logic of its own. Set SECRETS_LIB to
# override discovery -- needed when this file is reached through a symlink,
# because resolving one would require readlink(1), which is not POSIX.
set -u

self=$0
case $self in
    */*) ;;
    *)   self=$(command -v -- "$self") || {
             printf 'secrets: cannot locate self (set SECRETS_LIB)\n' >&2
             exit 127
         } ;;
esac
# ${self%/*} is empty when $0 sits at the filesystem root ("/secrets").
selfdir=${self%/*}
[ -n "$selfdir" ] || selfdir=/
dir=$(unset CDPATH; cd -- "$selfdir" && pwd) || {
    printf 'secrets: cannot resolve own directory from %s (set SECRETS_LIB)\n' \
        "$self" >&2
    exit 127
}

# -f as well as -r: a directory is readable, and sourcing one fails with a
# raw shell error instead of the branded message below.
if [ -n "${SECRETS_LIB:-}" ] && { [ ! -f "$SECRETS_LIB" ] || [ ! -r "$SECRETS_LIB" ]; }
then
    printf 'secrets: SECRETS_LIB=%s is not a readable file\n' "$SECRETS_LIB" >&2
    exit 127
fi

for cand in \
    "${SECRETS_LIB:-}" \
    "$dir/../share/secrets/secrets-lib.sh" \
    "$dir/../lib/secrets-lib.sh" \
    "$dir/secrets-lib.sh" \
    "${HOME:-}/.local/share/secrets/secrets-lib.sh" \
    /usr/local/share/secrets/secrets-lib.sh \
    /usr/share/secrets/secrets-lib.sh
do
    if [ -z "$cand" ] || [ ! -f "$cand" ] || [ ! -r "$cand" ]; then continue; fi
    # shellcheck disable=SC1090  # path is resolved at runtime
    . "$cand"
    # A readable file that is not the library leaves secrets() undefined.
    # command -v prints a bare name for a function, a path for an executable,
    # so this does not match bin/secrets itself when it is on PATH.
    case $(command -v secrets 2>/dev/null) in
        secrets) ;;
        *) printf 'secrets: %s did not define the secrets() function\n' "$cand" >&2
           exit 127 ;;
    esac
    secrets "$@"
    exit $?
done

printf 'secrets: cannot find secrets-lib.sh (set SECRETS_LIB to its path)\n' >&2
exit 127
